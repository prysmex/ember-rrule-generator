import { hash } from '@ember/helper';
import BaseContainerComponent from '../base-container.gts';

export default class ContainersEndSelectModeComponent extends BaseContainerComponent {
  <template>
    {{#if (has-block)}}
      {{yield
        (hash
          options=@options
          handleChange=this.handleChange
          value=@value
          id=@id
          name=@name
          translations=@translations
          labels=@labels
          isDisabled=@isDisabled
        )
      }}
    {{else}}
      {{#if @view}}
        {{#let (component @view) as |SelectComponent|}}
          <SelectComponent
            @id={{@id}}
            id={{@id}}
            @name={{@name}}
            name={{@name}}
            @isDisabled={{@isDisabled}}
            @options={{@options}}
            @value={{@value}}
            @handleChange={{this.handleChange}}
            @translations={{@translations}}
            @labels={{@labels}}
            ...attributes
          />
        {{/let}}
      {{/if}}
    {{/if}}
  </template>
}
