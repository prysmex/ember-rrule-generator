{
  "name": "ember-rrule-generator",
  "version": "0.6.1",
  "description": "Headless rrule generator components for Ember",
  "keywords": [
    "ember-addon",
    "rrule",
    "recurrence"
  ],
  "homepage": "https://github.com/prysmex/ember-rrule-generator",
  "bugs": "https://github.com/prysmex/ember-rrule-generator/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prysmex/ember-rrule-generator.git"
  },
  "license": "MIT",
  "author": "betocantu93 <betocantu93@gmail.com>",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./components/r-rule-generator": {
      "types": "./declarations/components/r-rule-generator/index.d.ts",
      "default": "./dist/components/r-rule-generator/index.js"
    },
    "./components/containers/end": {
      "types": "./declarations/components/containers/end/index.d.ts",
      "default": "./dist/components/containers/end/index.js"
    },
    "./components/containers/repeat": {
      "types": "./declarations/components/containers/repeat/index.d.ts",
      "default": "./dist/components/containers/repeat/index.js"
    },
    "./components/containers/start": {
      "types": "./declarations/components/containers/start/index.d.ts",
      "default": "./dist/components/containers/start/index.js"
    },
    "./components/containers/timezone": {
      "types": "./declarations/components/containers/timezone/index.d.ts",
      "default": "./dist/components/containers/timezone/index.js"
    },
    "./*.css": "./dist/*.css",
    "./*.js": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup --config && node scripts/verify-app-reexports.mjs",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "pnpm build && publint run --level error",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite dev",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.9",
